# Автоматическая нормализация окончаний строк
* text=auto

# Исходный код
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.java text eol=lf
*.go text eol=lf
*.rs text eol=lf

# Документация
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Конфигурация
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
Makefile text eol=lf
CMakeLists.txt text eol=lf

# Бинарные файлы
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.o binary
*.a binary
*.lib binary

# Изображения
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text

# Архивы
*.zip binary
*.tar binary
*.gz binary
*.rar binary

